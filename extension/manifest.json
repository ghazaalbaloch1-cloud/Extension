{
  "manifest_version": 3,
  "name": "Extension — Blogger Access Bridge",
  "version": "1.0.0",
  "description": "Secure local bridge between the Extension CMS and independently authorized Blogger accounts.",
  "permissions": ["identity", "storage"],
  "host_permissions": [
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://accounts.google.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "Extension Blogger Access",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://ghazaalbaloch1-cloud.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  }
}
